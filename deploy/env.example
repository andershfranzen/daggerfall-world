# Copy to deploy/.env (git-ignored). Never commit the filled-in copy.
# Public hostname. DNS A/AAAA records must point at this machine before first start.
DFW_DOMAIN=play.example.org
# Optional: contact address for the ACME (Let's Encrypt) account.
ACME_EMAIL=
# Absolute path on the host to the operator's ARENA2 folder. Mounted read-only.
ARENA2_HOST_DIR=/srv/daggerfall/arena2
MAX_PLAYERS=64
