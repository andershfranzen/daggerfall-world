# Copy to deploy/.env (git-ignored). Never commit the filled-in copy.
# Public hostname. DNS A/AAAA records must point at this machine before first start.
DFW_DOMAIN=play.example.org
# Optional: contact address for the ACME (Let's Encrypt) account.
ACME_EMAIL=
# Absolute path on the host to the operator's ARENA2 folder. Mounted read-only.
ARENA2_HOST_DIR=/srv/daggerfall/arena2
MAX_PLAYERS=64

# ---------------------------------------------------------------- Optional PostgreSQL backend
# Leave DATABASE_URL unset to keep the default zero-config SQLite backend.
# To run with PostgreSQL via Compose:
#   docker compose -f deploy/compose.yaml --env-file deploy/.env --profile postgres up -d --build
# See docs/postgresql-migration.md for setup, migration, and backups.
#POSTGRES_DB=daggerfallworld
#POSTGRES_USER=dfw
#POSTGRES_PASSWORD=replace-with-a-strong-random-password
#DATABASE_URL=postgresql://dfw:replace-with-a-strong-random-password@postgres:5432/daggerfallworld
# Optional: split accounts into a separate PostgreSQL database (defaults to DATABASE_URL).
#ACCOUNTS_DATABASE_URL=
